# ==========================================
# CATALYST 2026 Environment Configuration
# ==========================================

# 1. Database Connection (Vercel Postgres / Neon / Supabase)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"
USERDB_PRISMA_DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# 2. Razorpay API Credentials (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"

# 3. Super Admin Credentials (Default: divya / ilyspry)
ADMIN_USERNAME="divya"
ADMIN_PASSWORD="ilyspry"
